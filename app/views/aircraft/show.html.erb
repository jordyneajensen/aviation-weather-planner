

<%# app/views/aircraft/show.html.erb %>
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Header with actions %>
  <div class="md:flex md:items-center md:justify-between mb-6">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        <%= @aircraft.registration %> - <%= @aircraft.make_model %>
      </h2>
    </div>
    <div class="mt-4 flex space-x-3 md:mt-0">
      <%= link_to edit_aircraft_path(@aircraft), 
          class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
        <i class="fas fa-edit mr-2"></i>
        Edit
      <% end %>

      <%= button_to aircraft_path(@aircraft), 
          method: :delete,
          data: { confirm: "Are you sure you want to delete this aircraft?" },
          class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
        <i class="fas fa-trash mr-2"></i>
        Delete
      <% end %>

      <%= link_to aircraft_index_path, 
          class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
        <i class="fas fa-arrow-left mr-2"></i>
        Back to List
      <% end %>
    </div>
  </div>

  <%# Status Badge %>
  <div class="mb-6">
    <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full
          <%= case @aircraft.status
              when 'active' then 'bg-green-100 text-green-800'
              when 'maintenance' then 'bg-yellow-100 text-yellow-800'
              else 'bg-gray-100 text-gray-800'
              end %>">
      <%= @aircraft.status&.titleize %>
    </span>
  </div>

  <%# Aircraft Details %>
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Aircraft Details</h3>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Registration</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @aircraft.registration %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Make & Model</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @aircraft.make_model %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Maximum Speed</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @aircraft.max_speed %> kts</dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Cruise Speed</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @aircraft.cruise_speed %> kts</dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Fuel Capacity</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @aircraft.fuel_capacity %> gal</dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Empty Weight</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @aircraft.empty_weight %> lbs</dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Max Takeoff Weight</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @aircraft.max_takeoff_weight %> lbs</dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Notes</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @aircraft.notes.present? ? @aircraft.notes : "No notes available" %>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</div>