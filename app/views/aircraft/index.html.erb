<%# app/views/aircraft/index.html.erb %>
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Header %>
  <div class="md:flex md:items-center md:justify-between mb-6">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        Aircraft Fleet
      </h2>
    </div>
    <div class="mt-4 flex md:mt-0 md:ml-4">
      <%= link_to new_aircraft_path, 
          class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
        <i class="fas fa-plus mr-2"></i>
        Add Aircraft
      <% end %>
    </div>
  </div>

  <%# Aircraft List %>
  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <% if @aircraft.any? %>
      <ul class="divide-y divide-gray-200">
        <% @aircraft.each do |aircraft| %>
          <li>
            <%= link_to aircraft_path(aircraft), class: "block hover:bg-gray-50" do %>
              <div class="px-4 py-4 sm:px-6">
                <div class="flex items-center justify-between">
                  <div class="flex items-center">
                    <div class="flex-shrink-0">
                      <i class="fas fa-plane text-blue-600 text-2xl"></i>
                    </div>
                    <div class="ml-4">
                      <p class="text-sm font-medium text-blue-600">
                        <%= aircraft.registration %>
                      </p>
                      <p class="text-sm text-gray-900">
                        <%= aircraft.make_model %>
                      </p>
                    </div>
                  </div>
                  <div class="ml-2 flex-shrink-0 flex">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                          <%= case aircraft.status
                              when 'active' then 'bg-green-100 text-green-800'
                              when 'maintenance' then 'bg-yellow-100 text-yellow-800'
                              else 'bg-gray-100 text-gray-800'
                              end %>">
                      <%= aircraft.status&.titleize %>
                    </span>
                  </div>
                </div>
                <div class="mt-2 sm:flex sm:justify-between">
                  <div class="sm:flex">
                    <p class="flex items-center text-sm text-gray-500">
                      <i class="fas fa-tachometer-alt flex-shrink-0 mr-1.5 text-gray-400"></i>
                      Max Speed: <%= aircraft.max_speed %> kts
                    </p>
                    <p class="mt-2 flex items-center text-sm text-gray-500 sm:mt-0 sm:ml-6">
                      <i class="fas fa-gas-pump flex-shrink-0 mr-1.5 text-gray-400"></i>
                      Fuel Capacity: <%= aircraft.fuel_capacity %> gal
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-12">
        <i class="fas fa-plane text-gray-400 text-4xl mb-4"></i>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No aircraft</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by adding a new aircraft.</p>
        <div class="mt-6">
          <%= link_to new_aircraft_path, 
              class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
            <i class="fas fa-plus mr-2"></i>
            Add Aircraft
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>